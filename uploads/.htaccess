# Students upload into these folders, so scripts must never execute here.
# Without this, an uploaded .php file would be a remote shell.
php_flag engine off
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<FilesMatch "\.(?i:php|phtml|php[0-9]|phar|cgi|pl|py|asp|aspx|sh)$">
    Require all denied
</FilesMatch>
